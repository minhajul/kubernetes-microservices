# Runtime state from local runs. bootstrap/cache must not leak a dev package
# manifest that references dev-only service providers.
bootstrap/cache/*.php
storage/logs/*
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/testing/*
storage/framework/views/*
storage/app/private/*
storage/app/public/*
storage/pail
storage/*.key
database/*.sqlite*
*.log

# Tests and dev tooling
tests
phpunit.xml
pint.json
.phpunit.cache
.phpunit.result.cache
